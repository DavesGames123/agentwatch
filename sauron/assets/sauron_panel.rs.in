// ═══════════════════════════════════════════════════════════════════════════
//  sauron_panel.rs — GENERATED FILE. DO NOT EDIT.
//
//  Regenerate with:  sauron panel install {{INSTALL_ARGS}}
//  Beacon format:    v{{VERSION}}
// ═══════════════════════════════════════════════════════════════════════════
//
//  An in-app pane showing what sauron currently says needs attending to in this
//  repo: agents that errored, agents blocked on a question, edits written but
//  never verified. It appears only while a sauron instance is actually watching
//  this project, and vanishes on its own when that instance goes away.
//
//  HOW IT KNOWS
//  ------------
//  sauron republishes a snapshot of its board every two seconds to
//  ~/.claude/sauron/beacons/<repo-path-with-dashes>.beacon. This file stats that
//  path a couple of times a second, re-reads it only when the mtime moves, and
//  refuses to draw anything whose `written` stamp is older than six seconds.
//
//  That staleness gate *is* the liveness check. Nothing has to notify this
//  process that sauron crashed, was SIGKILLed, or that the laptop lid closed —
//  all three stop the writes, and the writes stopping is the entire signal. If
//  the pane ever survives more than ~6s past `pkill sauron`, the gate is broken,
//  not the format.
//
//  COST
//  ----
//  Collapsed: one `stat` at most twice a second plus a single header strip.
//  Expanded: one text layout per visible row. Nothing is allocated on frames
//  where the beacon has not changed.
//
//  WIRING
//  ------
//    1. `mod sauron_panel;` behind whatever feature/cfg gates your debug build
//    2. call `sauron_panel::render(ctx)` once per frame, after your own UI so it
//       draws on top
//    3. optionally `sauron_panel::set_visible(bool)` from a key binding
//
//  ROUTES
//  ------
//  When the watched repo ships a `.sauron/panels.toml`, each row also carries
//  where to look in order to see its edits -- which panel, how to open it, and
//  what must be true first. The pane shows that itself, and `route_anchors()`
//  hands the host the names of the controls involved so it can ring the real
//  button. Those names come from the map, so they are whatever that project
//  calls its own UI; this file never interprets them.
//
//  A repo with no map produces no routes and the pane looks exactly as it did
//  before the feature existed.
//
//  PLACEMENT
//  ---------
//  Docked to the left margin by default. Drag the header strip to move it; the
//  clamp keeps a grabbable piece of that strip on screen, so it can be parked
//  half off either edge but never lost. Clicking the header folds the pane to
//  the strip alone, which stays draggable. Neither survives a relaunch, on
//  purpose: a debug pane that remembers being hidden is one you forget exists.
//
//  grep targets:
//    fn render          -- the once-per-frame entry point
//    fn poll            -- mtime-gated re-read
//    fn beacon_path     -- $SAURON_BEACON, else git root -> encoded path
//    fn parse           -- the v{{VERSION}} wire format reader
//    fn draw_header     -- fold control and drag handle, one surface
//    fn draw_row        -- one session card
//    fn route_anchors   -- controls the host should highlight, for `needs_test`
//    fn route_steps     -- the same routes, with their instructions
//    const DEFAULT_POS  -- where it docks before anyone moves it
//    const STALE_MS     -- how old a beacon may be and still count as live
//    struct Palette     -- every colour in one place, for retheming

// A generated file cannot know which of its knobs the host wired up. Warning
// about the ones it did not would make a clean build noisy for a debug pane.
#![allow(dead_code)]

{{EGUI_IMPORT}}

use std::collections::{BTreeSet, HashMap};
use std::path::PathBuf;
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::{Mutex, OnceLock};
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};

// ───────────────────────────────────────────────────────────────────────────
//  Contract with sauron
// ───────────────────────────────────────────────────────────────────────────

/// Wire format this file was generated against. A beacon announcing anything
/// else is refused outright rather than parsed optimistically — a pane drawn
/// from misaligned columns looks authoritative while being wrong, which is
/// worse than no pane at all. Re-run `sauron panel install` on a mismatch.
const WIRE_VERSION: u32 = {{VERSION}};

/// How stale a beacon may be before sauron counts as gone. Three times its
/// publish interval: one missed write is a slow scan, three is a dead process.
const STALE_MS: i64 = {{STALE_MS}};

/// How often the beacon file is stat'd. The data only moves every 2s, so
/// polling faster buys nothing; polling slower makes the pane feel laggy when
/// an agent errors.
const POLL: Duration = Duration::from_millis(500);

// ───────────────────────────────────────────────────────────────────────────
//  Look
// ───────────────────────────────────────────────────────────────────────────

const PAD_BASE: f32 = 10.0;
fn pad() -> f32 { PAD_BASE * sc() }
/// Header strip height. A constant rather than a measurement because the drag
/// clamp needs it *outside* the closure that draws the header.
const HEADER_H_BASE: f32 = 30.0;
fn header_h() -> f32 { HEADER_H_BASE * sc() }

/// Where the pane sits until someone drags it: docked against the left margin,
/// under the top edge.
const DEFAULT_POS: [f32; 2] = [16.0, 16.0];

/// How much of the header must stay on screen. Dragging is clamped to this, so
/// the pane can be parked mostly off either edge -- useful when it is in the way
/// of something you are actually looking at -- without ever becoming impossible
/// to grab back.
const GRAB_MARGIN_BASE: f32 = 56.0;
fn grab_margin() -> f32 { GRAB_MARGIN_BASE * sc() }

/// Every colour the pane uses. Grouped so a host project can retheme by editing
/// one block — the only edit to this file that survives a regeneration cleanly,
/// because it is contiguous.
/// Every colour the pane uses — one struct so a host can restyle the whole
/// thing in a single call.
///
/// Width is deliberately NOT here. The pane is a table of fixed columns and its
/// width is the sum of them; a host-settable width would be a knob that either
/// did nothing or clipped a column, and a dead knob on a struct is a lie that
/// costs someone an afternoon.
///
/// WHY THIS IS NOT A BLOCK OF CONSTANTS ANY MORE
/// --------------------------------------------
/// It used to be, with a comment claiming a contiguous block was the one edit
/// that survived regeneration cleanly. That was wrong twice over. Editing a
/// GENERATED file means re-applying the edit after every `panel install`, which
/// is a chore that eventually gets skipped. And a host whose own palette is
/// user-switchable at runtime — a theme picker in its settings — cannot be
/// served by baked constants at all: the pane would sit in the corner wearing
/// last week's colours while everything around it changed.
///
/// So the values live in a host-settable struct and `Default` reproduces the
/// original look exactly. A host that never calls `set_skin` sees no change.
#[derive(Debug, Clone, Copy)]
pub struct Skin {
    pub bg: egui::Color32,
    pub edge: egui::Color32,
    pub header_bg: egui::Color32,
    pub title: egui::Color32,
    pub dim: egui::Color32,
    pub faint: egui::Color32,
    pub row_hover: egui::Color32,
    pub rule: egui::Color32,
    pub file: egui::Color32,

    pub errored: egui::Color32,
    pub blocked: egui::Color32,
    pub awaiting_ack: egui::Color32,
    pub needs_test: egui::Color32,
    pub running: egui::Color32,

    /// The route: where to go to look at a change. A host drawing its own
    /// highlight should use this same colour, or the pane and the highlight
    /// read as two unrelated claims rather than one.
    pub route: egui::Color32,
    pub route_dim: egui::Color32,

    /// How large the pane draws, against a design baseline of raw pixels.
    ///
    /// NOT cosmetic, and the single most important field here. A host may run
    /// its own UI at 2-4x for a high-DPI screen or simply because its chrome is
    /// meant to be read across a room. This pane paints most of its text by
    /// hand at explicit sizes, so without a scale it renders at raw pixels
    /// beside widgets drawn at the host's — text a quarter the size of the
    /// buttons next to it, and columns sized in pixels far too narrow for the
    /// text actually landing in them, which then wraps one word per line and
    /// overruns the row it was measured for.
    ///
    /// Every length and every font size in this file is multiplied by it.
    /// 1.0 reproduces the original look exactly.
    pub scale: f32,
}

impl Default for Skin {
    fn default() -> Self {
        Self {
            bg: egui::Color32::from_rgba_premultiplied(10, 12, 17, 236),
            edge: egui::Color32::from_rgb(58, 66, 84),
            header_bg: egui::Color32::from_rgba_premultiplied(20, 24, 33, 245),
            title: egui::Color32::from_rgb(214, 222, 236),
            dim: egui::Color32::from_rgb(122, 132, 150),
            faint: egui::Color32::from_rgb(86, 94, 110),
            row_hover: egui::Color32::from_rgba_premultiplied(38, 44, 58, 120),
            rule: egui::Color32::from_rgb(38, 44, 57),
            file: egui::Color32::from_rgb(146, 172, 200),

            errored: egui::Color32::from_rgb(255, 92, 92),
            blocked: egui::Color32::from_rgb(255, 178, 66),
            awaiting_ack: egui::Color32::from_rgb(150, 200, 255),
            needs_test: egui::Color32::from_rgb(112, 222, 168),
            running: egui::Color32::from_rgb(140, 146, 168),

            route: egui::Color32::from_rgb(112, 222, 168),
            route_dim: egui::Color32::from_rgb(78, 150, 118),

            scale: 1.0,
        }
    }
}

static SKIN: OnceLock<Mutex<Skin>> = OnceLock::new();

fn skin_state() -> &'static Mutex<Skin> {
    SKIN.get_or_init(|| Mutex::new(Skin::default()))
}

/// Restyle the pane. Cheap enough to call every frame, which is the right way
/// to drive it from a host whose theme can change under the user.
///
///   grep -n "fn set_skin"  sauron_panel.rs
pub fn set_skin(s: Skin) {
    if let Ok(mut cur) = skin_state().lock() {
        *cur = s;
    }
}

/// The current skin, or the default if a lock is somehow poisoned. Never
/// returns an error: a debug pane that refuses to draw because a colour was
/// unavailable would be a worse failure than drawing in the wrong colour.
pub fn skin() -> Skin {
    skin_state().lock().map(|s| *s).unwrap_or_default()
}

/// The pane's scale factor. Read once per drawing function rather than per
/// call site, so a frame cannot draw half at one size and half at another.
fn sc() -> f32 {
    // Clamped, not merely defaulted. A host that hands over its own UI scale
    // unmodified can make this pane illegible at one end and wider than the
    // window it floats over at the other, and neither failure announces itself
    // as a scale problem -- one reads as broken text, the other as a broken
    // layout.
    skin().scale.clamp(0.85, 1.5)
}

/// Named accessors, so call sites read the way they did when these were
/// constants. The SCREAMING_CASE-function spelling is deliberate: it is what
/// this pane's first host uses for exactly the same reason — a colour that
/// reads the live theme cannot be a const, and renaming every call site to say
/// so would be churn for nothing.
#[allow(non_snake_case)]
struct Palette;

#[allow(non_snake_case)]
impl Palette {
    fn BG() -> egui::Color32 { skin().bg }
    fn EDGE() -> egui::Color32 { skin().edge }
    fn HEADER_BG() -> egui::Color32 { skin().header_bg }
    fn TITLE() -> egui::Color32 { skin().title }
    fn DIM() -> egui::Color32 { skin().dim }
    fn FAINT() -> egui::Color32 { skin().faint }
    fn ROW_HOVER() -> egui::Color32 { skin().row_hover }
    fn RULE() -> egui::Color32 { skin().rule }
    fn FILE() -> egui::Color32 { skin().file }

    fn ERRORED() -> egui::Color32 { skin().errored }
    fn BLOCKED() -> egui::Color32 { skin().blocked }
    fn AWAITING_ACK() -> egui::Color32 { skin().awaiting_ack }
    fn NEEDS_TEST() -> egui::Color32 { skin().needs_test }
    fn RUNNING() -> egui::Color32 { skin().running }

    fn ROUTE() -> egui::Color32 { skin().route }
    fn ROUTE_DIM() -> egui::Color32 { skin().route_dim }
}

/// The wire status token -> how it is grouped, coloured and titled.
///
/// The order of this table is the order the groups appear, and it is sauron's
/// own ranking: an errored agent is dead until rescued, a blocked one resumes
/// the moment you answer, and unverified edits merely wait. Reordering these
/// reorders the pane.
/// The wire status token -> how it is grouped and titled.
///
/// The order of this table is the order the groups appear, and it is sauron's
/// own ranking: an errored agent is dead until rescued, a blocked one resumes
/// the moment you answer, and unverified edits merely wait. Reordering these
/// reorders the pane.
///
/// The colour is looked up separately rather than stored here, because a skin
/// is resolved at draw time and this table is a `const`.
const GROUPS: &[(&str, &str)] = &[
    ("errored", "ERRORED"),
    ("blocked", "WAITING ON YOU"),
    ("awaiting_ack", "AWAITING ACK"),
    ("needs_test", "AWAITING TEST"),
    ("working", "RUNNING"),
    ("delegated", "DELEGATED"),
];

/// Whether a status is one that is waiting on a person, and so worth a reply
/// box. Mirrors sauron's own `wants_human`.
fn wants_human(status: &str) -> bool {
    matches!(status, "errored" | "blocked" | "awaiting_ack" | "needs_test")
}

fn group_colour(token: &str) -> egui::Color32 {
    match token {
        "errored" => Palette::ERRORED(),
        "blocked" => Palette::BLOCKED(),
        "awaiting_ack" => Palette::AWAITING_ACK(),
        "needs_test" => Palette::NEEDS_TEST(),
        _ => Palette::RUNNING(),
    }
}

fn group_of(status: &str) -> Option<(&'static str, egui::Color32, usize)> {
    GROUPS
        .iter()
        .position(|(tok, _)| *tok == status)
        .map(|i| (GROUPS[i].1, group_colour(GROUPS[i].0), i))
}

// ───────────────────────────────────────────────────────────────────────────
//  Parsed beacon
// ───────────────────────────────────────────────────────────────────────────

#[derive(Debug, Clone, Default)]
struct Row {
    status: String,
    id_short: String,
    /// The full session id. `id_short` is for eyes; this is the only form that
    /// can address a session, which is what the reply panel needs.
    id: String,
    turn_started: i64,
    last_activity: i64,
    is_orc: bool,
    total_edits: usize,
    name: String,
    detail: String,
    files: Vec<String>,
    /// Where to look in order to see this row's edits, best first. Empty when
    /// the watched repo publishes no map.
    steps: Vec<Step>,
    /// Files no surface claims. Shown rather than swallowed: a map that has
    /// fallen behind the code still emits routes that look complete, and this
    /// count is the only outward sign.
    unmapped: usize,
    truncated: usize,
    has_map: bool,
}

/// One surface to open.
#[derive(Debug, Clone, Default)]
struct Step {
    /// What the host's own UI calls this control; empty when it has no button.
    /// `route_anchors` hands these to the host so it can ring the real thing.
    anchor: String,
    title: String,
    hits: usize,
    confidence: String,
    open: String,
    needs: Vec<String>,
}

impl Step {
    /// Whether the map's author traced this route to a call site rather than
    /// reasoning it out. Shown, so a guess never reads as an instruction.
    fn is_verified(&self) -> bool {
        self.confidence == "verified"
    }
}

#[derive(Debug, Clone, Default)]
struct Beacon {
    label: String,
    pid: u32,
    written_ms: i64,
    attention: usize,
    working: usize,
    clear: usize,
    hidden_stale: usize,
    rows: Vec<Row>,
}

// ───────────────────────────────────────────────────────────────────────────
//  State
// ───────────────────────────────────────────────────────────────────────────

/// Host-controlled master switch, so a key binding can hide the pane outright
/// without the host having to gate the `render` call itself.
static VISIBLE: AtomicBool = AtomicBool::new(true);

// ───────────────────────────────────────────────────────────────────────────
//  Replying
// ───────────────────────────────────────────────────────────────────────────

/// One row's unsent reply.
///
/// Keyed per session rather than one panel with a target, because the board is
/// a list of things waiting on you and answering them one modal at a time is
/// the wrong shape: you read three rows, then answer two. A draft that survives
/// looking at another row is the whole point.
#[derive(Debug, Clone, Default)]
struct Draft {
    /// What has already been said to this agent, oldest first.
    ///
    /// Sending clears the editor, which is right -- a box still holding text
    /// you already sent reads as unsent. But it also made the message vanish
    /// with nothing but "sent" to show for it, so there was no way to see what
    /// you had told an agent thirty seconds earlier while looking at what it
    /// did next.
    ///
    /// In memory only, and deliberately: the durable record of a reply is the
    /// agent's own transcript, and a pane that persisted its own half of the
    /// conversation would be a second source of truth that could disagree with
    /// it.
    sent: Vec<String>,
    text: String,
    /// Absolute path to a screenshot to send along, if one was taken.
    attach: String,
    /// Last thing that happened, shown under the box. Cleared on edit.
    status: String,
}

/// Exactly the line sauron will type at the agent.
///
/// MUST MATCH `line_for` IN reply.rs. The editor is multiline and the agent's
/// prompt reads a line, so what is sent is the draft with its whitespace
/// collapsed and the attachment appended as a path -- which is not what was
/// typed. Echoing the draft instead of this would show a message that was never
/// delivered, and the entire point of showing it is to know what the agent
/// actually received.
///
///   grep -n "fn line_for"  src/reply.rs
fn delivered_line(text: &str, attach: &str) -> String {
    let mut s = text.split_whitespace().collect::<Vec<_>>().join(" ");
    if !attach.is_empty() {
        s.push_str(&format!(" (screenshot: {attach})"));
    }
    s
}

/// How many sent messages a row keeps on screen. Enough to see the thread you
/// are in the middle of; not so many that one chatty row pushes the rest of the
/// board off the pane.
const SENT_KEPT: usize = 3;

static DRAFTS: OnceLock<Mutex<HashMap<String, Draft>>> = OnceLock::new();

fn drafts() -> &'static Mutex<HashMap<String, Draft>> {
    DRAFTS.get_or_init(|| Mutex::new(HashMap::new()))
}

/// Where queued messages go, mirroring `beacon_path`'s resolution so the two
/// halves of the conversation cannot end up in different directories.
///
///   grep -n "fn outbox_dir"  sauron_panel.rs
fn outbox_dir() -> Option<PathBuf> {
    if let Some(explicit) = std::env::var_os("SAURON_OUTBOX") {
        return Some(PathBuf::from(explicit));
    }
    let home = std::env::var_os("HOME").map(PathBuf::from)?;
    Some(home.join(".claude").join("sauron").join("outbox"))
}

/// Queue one message for the running sauron to deliver.
///
/// Written under a dot-name and renamed, because sauron drains this directory
/// every two seconds and a reader that catches a half-written file would
/// deliver half a sentence. `rename` is atomic on every filesystem this runs
/// on, so the message either exists whole or not at all.
///
///   grep -n "fn queue_message"  sauron_panel.rs
fn queue_message(kind: &str, session: &str, text: &str, attach: &str) -> Result<(), String> {
    let dir = outbox_dir().ok_or("no HOME")?;
    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;

    let now = now_ms();
    let mut body = String::new();
    body.push_str(&format!("kind\t{}\n", esc(kind)));
    body.push_str(&format!("session\t{}\n", esc(session)));
    body.push_str(&format!("queued\t{now}\n"));
    if !attach.is_empty() {
        body.push_str(&format!("attach\t{}\n", esc(attach)));
    }
    body.push_str(&format!("text\t{}\n", esc(text)));
    body.push_str("end\n");

    let stem = format!("{now}-{}", session.split('-').next().unwrap_or("x"));
    let tmp = dir.join(format!(".{stem}.tmp"));
    let dst = dir.join(format!("{stem}.msg"));
    std::fs::write(&tmp, body).map_err(|e| e.to_string())?;
    std::fs::rename(&tmp, &dst).map_err(|e| e.to_string())?;
    Ok(())
}

/// Grab the screen to a file and return its path.
///
/// WHY THIS OFTEN FAILS, AND WHY THE ERROR IS SHOWN
/// -----------------------------------------------
/// `screencapture` needs macOS Screen Recording permission, granted per binary
/// in System Settings. A development build is ad-hoc signed and its identity
/// changes as it is rebuilt, so the grant does not reliably stick -- the
/// failure is `could not create image from display`, and it is a permission to
/// grant rather than a bug to chase. The caller shows that text verbatim
/// instead of leaving an empty attachment behind.
///
/// The alternative that never needs a permission is reading back the host's own
/// framebuffer, which also captures exactly the window you care about rather
/// than the whole desktop -- but that means a GPU copy pass and an opinion
/// about the host's render graph, so it belongs to the host, not here.
///
///   grep -n "fn take_screenshot"  sauron_panel.rs
fn take_screenshot() -> Result<String, String> {
    let path = std::env::temp_dir().join(format!("sauron-shot-{}.png", now_ms()));
    let out = std::process::Command::new("screencapture")
        .arg("-x")
        .arg(&path)
        .output()
        .map_err(|e| format!("screencapture: {e}"))?;
    if !out.status.success() || !path.exists() {
        let why = String::from_utf8_lossy(&out.stderr).trim().to_string();
        return Err(if why.is_empty() { "screencapture wrote nothing".into() } else { why });
    }
    Ok(path.to_string_lossy().to_string())
}


/// The row the cursor is on, and what it connects to: the card's rect in
/// screen space plus the anchors its route names.
///
/// Written by `draw_row`, read by the host through `hover_link`. Cleared at the
/// top of every `render` so a frame with no hover produces no link — including
/// the frames where the pane refuses to draw at all, which is what stops a
/// cable being left dangling when sauron dies mid-hover.
static HOVER: OnceLock<Mutex<Option<(egui::Rect, Vec<String>)>>> = OnceLock::new();

fn hover_state() -> &'static Mutex<Option<(egui::Rect, Vec<String>)>> {
    HOVER.get_or_init(|| Mutex::new(None))
}

/// Whether the pane is folded to its header strip. Persists for the process
/// lifetime; deliberately not written to disk, because a debug pane that
/// remembers being closed across launches is a debug pane you forget exists.
static COLLAPSED: AtomicBool = AtomicBool::new(false);

struct State {
    path: Option<PathBuf>,
    /// `None` until the first poll; `Some(None)` means polled and found nothing.
    last_poll: Option<Instant>,
    last_mtime: Option<SystemTime>,
    beacon: Option<Beacon>,
    /// `id_short` of rows whose file list is unfolded.
    expanded: BTreeSet<String>,
    /// Top-left of the pane. `None` until the first frame resolves it to
    /// `DEFAULT_POS`.
    ///
    /// Held here rather than left to egui's own `Area` dragging, because that
    /// makes the *whole* pane a drag surface -- and every row in this pane is a
    /// click target that folds a file list. Owning the position means the header
    /// is the only thing that moves it, which is also what lets the pane be
    /// dragged while collapsed to a single strip.
    pos: Option<egui::Pos2>,
}

fn state() -> &'static Mutex<State> {
    static S: OnceLock<Mutex<State>> = OnceLock::new();
    S.get_or_init(|| {
        Mutex::new(State {
            path: beacon_path(),
            last_poll: None,
            last_mtime: None,
            beacon: None,
            expanded: BTreeSet::new(),
            pos: None,
        })
    })
}

/// Move the pane's top-left corner. Clamped on the next frame like a drag is,
/// so a host cannot park it somewhere unreachable.
pub fn set_position(pos: egui::Pos2) {
    if let Ok(mut st) = state().lock() {
        st.pos = Some(pos);
    }
}

/// Put the pane back in its default corner.
pub fn reset_position() {
    set_position(egui::pos2(DEFAULT_POS[0], DEFAULT_POS[1]));
}

/// Show or hide the pane. Independent of the collapsed state, so toggling it
/// back on returns it to whichever fold the user left it in.
pub fn set_visible(v: bool) {
    VISIBLE.store(v, Ordering::Relaxed);
}

pub fn is_visible() -> bool {
    VISIBLE.load(Ordering::Relaxed)
}

pub fn toggle_visible() {
    VISIBLE.fetch_xor(true, Ordering::Relaxed);
}

// ───────────────────────────────────────────────────────────────────────────
//  Routes, for a host that wants to highlight the thing to press
// ───────────────────────────────────────────────────────────────────────────

/// The controls a host should draw attention to right now, best first, without
/// duplicates.
///
/// These are the `anchor` strings from the watched repo's own
/// `.sauron/panels.toml` — whatever that project calls its own buttons. This
/// file cannot know what they mean, and deliberately does not try: it hands
/// them back, and the host matches them against its own controls and rings
/// whatever it finds. A surface with no button has an empty anchor and is
/// omitted here, because there is nothing to point at.
///
/// SCOPED TO `needs_test`, AND THAT IS THE WHOLE DESIGN
/// ---------------------------------------------------
/// Only rows awaiting test contribute. Every other attention status wants a
/// different verb: an errored agent needs rescuing, a blocked one needs
/// answering, and ringing a panel for either would be telling someone to go
/// look at work that is not finished. "Edits written, nobody has looked yet" is
/// the one state where opening a panel is the correct next action.
///
/// Returns empty when sauron is not running, when the beacon is stale, when the
/// repo ships no map, or when nothing is awaiting test — so a host can call it
/// unconditionally every frame and get silence whenever silence is right.
///
///   grep -n "fn route_anchors"  sauron_panel.rs
pub fn route_anchors() -> Vec<String> {
    let Ok(mut st) = state().lock() else {
        return Vec::new();
    };
    poll(&mut st);
    let now = now_ms();
    let Some(b) = st.beacon.as_ref().filter(|b| now.saturating_sub(b.written_ms) < STALE_MS)
    else {
        return Vec::new();
    };
    let mut out: Vec<String> = Vec::new();
    for r in b.rows.iter().filter(|r| r.status == "needs_test") {
        for s in &r.steps {
            if !s.anchor.is_empty() && !out.contains(&s.anchor) {
                out.push(s.anchor.clone());
            }
        }
    }
    out
}

/// The card the cursor is on and the controls its route names:
/// `(row_rect_in_screen_space, anchors)`.
///
/// For a host that wants to draw a line from the task to the thing it is about
/// — the pane says "Colony / X-ray", this says which pixels to run a cable
/// between. `None` whenever the cursor is not on a row, so a host can call it
/// every frame and get silence when silence is right.
///
/// UNLIKE `route_anchors`, THIS IGNORES STATUS
/// ------------------------------------------
/// Any row answers, not just `needs_test`. Ambient rings are a claim that
/// something needs doing, and only rows awaiting test qualify. A hover is not a
/// claim — it is a question the user just asked, about that specific row, and
/// the honest answer to "where does this one live" does not depend on whether
/// the agent has finished.
///
/// ONE FRAME BEHIND, ON PURPOSE
/// ----------------------------
/// The rect is whatever the pane measured last frame, because a host's overlay
/// chain may well run before the pane draws. Chasing that with a two-pass
/// handshake would cost more than it buys: at any hover the cursor is still on
/// the row a frame later, and a cable that lags one frame is a cable nobody
/// notices lagging.
///
///   grep -n "fn hover_link"  sauron_panel.rs
pub fn hover_link() -> Option<(egui::Rect, Vec<String>)> {
    hover_state().lock().ok()?.clone()
}

/// The full route for every row awaiting test: `(anchor, title, open, needs)`.
///
/// For a host that wants to render the instruction itself — a toast, a step
/// list beside the highlight — rather than only ringing a button. Same scope
/// and same emptiness guarantees as `route_anchors`.
///
///   grep -n "fn route_steps"  sauron_panel.rs
pub fn route_steps() -> Vec<(String, String, String, Vec<String>)> {
    let Ok(mut st) = state().lock() else {
        return Vec::new();
    };
    poll(&mut st);
    let now = now_ms();
    let Some(b) = st.beacon.as_ref().filter(|b| now.saturating_sub(b.written_ms) < STALE_MS)
    else {
        return Vec::new();
    };
    b.rows
        .iter()
        .filter(|r| r.status == "needs_test")
        .flat_map(|r| r.steps.iter())
        .map(|s| (s.anchor.clone(), s.title.clone(), s.open.clone(), s.needs.clone()))
        .collect()
}

// ───────────────────────────────────────────────────────────────────────────
//  Locating the beacon
// ───────────────────────────────────────────────────────────────────────────

/// `$SAURON_BEACON` if set, otherwise `~/.claude/sauron/beacons/<encoded>` for
/// the git root above the current directory.
///
/// The encoding is Claude Code's: every `/` and `.` in the absolute path becomes
/// `-`. Reusing it rather than hashing is what keeps this file dependency-free —
/// a hash would mean pulling in sha2 to render a debug pane.
fn beacon_path() -> Option<PathBuf> {
    if let Some(explicit) = std::env::var_os("SAURON_BEACON") {
        return Some(PathBuf::from(explicit));
    }
    let root = git_root()?;
    let root = root.canonicalize().unwrap_or(root);
    let encoded = root.to_string_lossy().replace(['/', '.'], "-");
    let home = std::env::var_os("HOME").map(PathBuf::from)?;
    Some(
        home.join(".claude")
            .join("sauron")
            .join("beacons")
            .join(format!("{encoded}.beacon")),
    )
}

fn git_root() -> Option<PathBuf> {
    let mut dir = std::env::current_dir().ok()?;
    loop {
        if dir.join(".git").exists() {
            return Some(dir);
        }
        if !dir.pop() {
            return None;
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
//  Polling
// ───────────────────────────────────────────────────────────────────────────

fn now_ms() -> i64 {
    SystemTime::now()
        .duration_since(UNIX_EPOCH)
        .map(|d| d.as_millis() as i64)
        .unwrap_or(0)
}

/// Re-read the beacon if it is time to look and the file has actually moved.
///
/// Two gates, not one. The clock gate bounds how often the syscall happens; the
/// mtime gate bounds how often the parse happens. Without the second, a pane
/// left open on an idle repo would re-parse the same bytes twice a second
/// forever.
fn poll(st: &mut State) {
    let now = Instant::now();
    if let Some(last) = st.last_poll {
        if now.duration_since(last) < POLL {
            return;
        }
    }
    st.last_poll = Some(now);

    let Some(path) = st.path.clone() else {
        return;
    };
    let mtime = std::fs::metadata(&path).ok().and_then(|m| m.modified().ok());
    let Some(mtime) = mtime else {
        // The file is gone: sauron exited cleanly and retired it. Drop what we
        // had rather than letting the last snapshot age out over STALE_MS.
        st.last_mtime = None;
        st.beacon = None;
        return;
    };
    if st.last_mtime == Some(mtime) && st.beacon.is_some() {
        return;
    }
    st.last_mtime = Some(mtime);
    st.beacon = std::fs::read_to_string(&path).ok().and_then(|t| parse(&t));
}

// ───────────────────────────────────────────────────────────────────────────
//  The v{{VERSION}} wire format
// ───────────────────────────────────────────────────────────────────────────

/// Escape the field separators out of free text, for a queued message.
///
/// Backslash first, or the escapes introduced for tab and newline would then
/// have their own backslashes escaped. Same ordering trap as the beacon's
/// reader half, same fix.
fn esc(s: &str) -> String {
    s.replace('\\', "\\\\").replace('\t', "\\t").replace('\n', "\\n")
}

fn unesc(s: &str) -> String {
    if !s.contains('\\') {
        return s.to_string();
    }
    let mut out = String::with_capacity(s.len());
    let mut chars = s.chars();
    while let Some(c) = chars.next() {
        if c != '\\' {
            out.push(c);
            continue;
        }
        match chars.next() {
            Some('t') => out.push('\t'),
            Some('n') => out.push('\n'),
            Some('\\') => out.push('\\'),
            Some(other) => out.push(other),
            None => {}
        }
    }
    out
}

/// Wire text -> `Beacon`, or `None` on anything unrecognised.
///
/// Fails closed on a bad magic line, a foreign version, or a file with no
/// trailing `end`. All three mean "do not draw".
fn parse(text: &str) -> Option<Beacon> {
    let mut lines = text.lines();
    let (magic, ver) = lines.next()?.split_once('\t')?;
    if magic != "sauron-beacon" || ver.trim().parse::<u32>().ok()? != WIRE_VERSION {
        return None;
    }

    let mut b = Beacon::default();
    let mut sealed = false;
    for line in lines {
        if line == "end" {
            sealed = true;
            break;
        }
        let Some((tag, rest)) = line.split_once('\t') else {
            continue;
        };
        match tag {
            "label" => b.label = unesc(rest),
            "pid" => b.pid = rest.parse().unwrap_or(0),
            "written" => b.written_ms = rest.parse().unwrap_or(0),
            "counts" => {
                let f: Vec<&str> = rest.split('\t').collect();
                b.attention = f.first().and_then(|v| v.parse().ok()).unwrap_or(0);
                b.working = f.get(1).and_then(|v| v.parse().ok()).unwrap_or(0);
                b.clear = f.get(2).and_then(|v| v.parse().ok()).unwrap_or(0);
                b.hidden_stale = f.get(3).and_then(|v| v.parse().ok()).unwrap_or(0);
            }
            "row" => {
                let f: Vec<&str> = rest.split('\t').collect();
                if f.len() < 8 {
                    continue;
                }
                b.rows.push(Row {
                    status: f[0].to_string(),
                    id_short: unesc(f[1]),
                    id: unesc(f[2]),
                    turn_started: f[3].parse().unwrap_or(0),
                    last_activity: f[4].parse().unwrap_or(0),
                    is_orc: f[5] == "1",
                    total_edits: f[6].parse().unwrap_or(0),
                    name: unesc(f[7]),
                    ..Row::default()
                });
            }
            "detail" => {
                if let Some(r) = b.rows.last_mut() {
                    r.detail = unesc(rest);
                }
            }
            "file" => {
                if let Some(r) = b.rows.last_mut() {
                    r.files.push(unesc(rest));
                }
            }
            "step" => {
                let f: Vec<&str> = rest.split('\t').collect();
                if f.len() < 5 {
                    continue;
                }
                if let Some(r) = b.rows.last_mut() {
                    r.steps.push(Step {
                        anchor: unesc(f[0]),
                        title: unesc(f[1]),
                        hits: f[2].parse().unwrap_or(0),
                        confidence: unesc(f[3]),
                        open: unesc(f[4]),
                        needs: Vec::new(),
                    });
                }
            }
            "need" => {
                if let Some(s) = b.rows.last_mut().and_then(|r| r.steps.last_mut()) {
                    s.needs.push(unesc(rest));
                }
            }
            "route" => {
                let f: Vec<&str> = rest.split('\t').collect();
                if let Some(r) = b.rows.last_mut() {
                    r.unmapped = f.first().and_then(|v| v.parse().ok()).unwrap_or(0);
                    r.truncated = f.get(1).and_then(|v| v.parse().ok()).unwrap_or(0);
                    // Presence, not content: a row with no `route` line came
                    // from a repo with no map, which is a different fact from a
                    // map that covered everything.
                    r.has_map = true;
                }
            }
            _ => {}
        }
    }
    if sealed {
        Some(b)
    } else {
        None
    }
}

// ───────────────────────────────────────────────────────────────────────────
//  Drawing
// ───────────────────────────────────────────────────────────────────────────

/// Once per frame, after the host's own UI. Draws nothing — and costs nothing
/// beyond an occasional `stat` — unless a live sauron is watching this repo.
pub fn render(ctx: &egui::Context) {
    // Cleared unconditionally, before any early return. A link that outlives
    // the row it came from would point at nothing, and the frames where this
    // function bails -- hidden, stale beacon, sauron gone -- are exactly the
    // frames where a stale cable would be left hanging on screen.
    if let Ok(mut h) = hover_state().lock() {
        *h = None;
    }
    if !VISIBLE.load(Ordering::Relaxed) {
        return;
    }

    // The whole snapshot is cloned out from under the lock before any drawing
    // starts. egui callbacks are the classic place to re-enter a lock you are
    // still holding; copying first makes that impossible by construction, and
    // the snapshot is a few hundred bytes.
    let (beacon, expanded, pos) = {
        let Ok(mut st) = state().lock() else {
            return;
        };
        poll(&mut st);
        let pos = *st
            .pos
            .get_or_insert(egui::pos2(DEFAULT_POS[0], DEFAULT_POS[1]));
        match &st.beacon {
            Some(b) => (b.clone(), st.expanded.clone(), pos),
            None => return,
        }
    };

    // The liveness gate. Everything above this line runs whether or not sauron
    // is up; nothing below it does.
    if now_ms().saturating_sub(beacon.written_ms) >= STALE_MS {
        return;
    }

    let mut toggled: Option<String> = None;
    let mut drag = egui::Vec2::ZERO;

    // `fixed_pos` and not `anchor`: an anchored area is re-pinned to its corner
    // every frame, so a dragged one snaps straight back. `movable(false)`
    // because the header does the dragging -- see `State::pos`.
    egui::Area::new(egui::Id::new("sauron_beacon_panel"))
        .fixed_pos(pos)
        .order(egui::Order::Foreground)
        .movable(false)
        .constrain(false)
        .show(ctx, |ui| {
            egui::Frame::none()
                .fill(Palette::BG())
                .stroke(egui::Stroke::new(1.0, Palette::EDGE()))
                .rounding(egui::Rounding::same(7.0))
                .inner_margin(egui::Margin::same(0.0))
                .show(ui, |ui| {
                    ui.set_width(panel_w());
                    ui.spacing_mut().item_spacing.y = 0.0;

                    drag = draw_header(ui, &beacon);
                    if COLLAPSED.load(Ordering::Relaxed) {
                        return;
                    }
                    ui.add_space(2.0);

                    let mut drew_any = false;
                    let mut n = 0usize;
                    for (token, _title) in GROUPS {
                        let rows: Vec<&Row> =
                            beacon.rows.iter().filter(|r| r.status == *token).collect();
                        if rows.is_empty() {
                            continue;
                        }
                        drew_any = true;
                        let colour = group_colour(token);
                        for r in rows {
                            let open = expanded.contains(&r.id_short);
                            if draw_board_row(ui, r, colour, open, n % 2 == 1) {
                                toggled = Some(r.id_short.clone());
                            }
                            n += 1;
                        }
                    }

                    if !drew_any {
                        draw_all_clear(ui);
                    }
                    draw_footer(ui, &beacon);
                });
        });

    if let Some(id) = toggled {
        if let Ok(mut st) = state().lock() {
            if !st.expanded.remove(&id) {
                st.expanded.insert(id);
            }
        }
    }


    // Applied after the area closes, because the clamp needs the screen rect and
    // the closure needs the position it was already given. The one-frame lag
    // this costs is the same lag egui's own windows have -- their move is also
    // stored at the end of the frame it was dragged in.
    if drag != egui::Vec2::ZERO {
        let screen = ctx.screen_rect();
        let mut p = pos + drag;
        p.x = p.x.clamp(
            screen.left() - panel_w() + grab_margin(),
            screen.right() - grab_margin(),
        );
        p.y = p.y.clamp(screen.top(), screen.bottom() - header_h());
        if let Ok(mut st) = state().lock() {
            st.pos = Some(p);
        }
    }
}

// ───────────────────────────────────────────────────────────────────────────
//  Board layout
// ───────────────────────────────────────────────────────────────────────────
//
//  ONE COLUMN, NOT FOUR
//  --------------------
//  This was a four-column table twice, and both times the columns were the
//  problem rather than the styling. A task name is 40-60 characters; a route is
//  a panel name; a reply is a sentence. Giving each a fixed slice of a pane that
//  has to sit over a game means every one of them is too narrow, and the longest
//  -- the title -- broke one word per line while a "WHERE TO LOOK" column sat
//  empty showing an em dash.
//
//  So each row is now full width and stacked, like a message in an inbox:
//
//      ● AWAITING ACK · 11m02s · 0 files · Interplanetary
//      Build Sauron GUI navigation guide system
//      [ reply to this agent…                  ] [send][shot][ack]
//
//  The metadata is one dim line, the title gets the whole width at the largest
//  size in the pane, and the reply spans the row. Nothing competes for
//  horizontal space, so nothing has to be cramped to fit.
//
//  EVERY INTERACTIVE RECT IS PLACED, NOT REQUESTED
//  ----------------------------------------------
//  `ui.button(..)` sizes itself from the host's style, and this host's style is
//  2-4x. Asking politely -- `Style::override_font_id`, a `RichText` font --
//  fixed the glyphs but not the padding, and missed entirely wherever the call
//  was written as a chained `.button(..)` the patch did not match. Buttons are
//  now `ui.put` into rects this file computes, so their size is a fact of the
//  layout rather than a property of whatever style happens to be in scope.

/// Base width of the pane, before scale. One column, sized for a task title.
const W_BASE: f32 = 430.0;

fn panel_w() -> f32 {
    W_BASE * sc()
}

/// A small action button, painted rather than added.
///
/// WHY NOT `egui::Button` IN A PLACED RECT
/// --------------------------------------
/// That was the previous attempt and it still came out wrong: `ui.put` fixes
/// where a widget goes, but a `Button` computes its own desired size from the
/// host's `button_padding`, and this host's padding is scaled 2-4x. The label
/// was then squeezed into what remained and wrapped -- one character per line,
/// "send" as a vertical s-e-n-d. Placing the rect was necessary and not
/// sufficient.
///
/// So the button is a rect, a stroke and a centred glyph run, drawn by this
/// file. `Align2::CENTER_CENTER` text cannot wrap, so the label is incapable of
/// stacking however narrow the box gets, and nothing about it can be changed by
/// a style this file does not own. `ui.interact` supplies the click without
/// bringing any layout opinion with it.
fn action_w() -> f32 { 42.0 * sc() }
fn action_h() -> f32 { 20.0 * sc() }

fn action_button(
    ui: &mut egui::Ui,
    id_src: (&str, &str),
    rect: egui::Rect,
    label: &str,
    on: bool,
) -> bool {
    let sk = skin();
    let k = sc();
    let id = ui.make_persistent_id(id_src);
    let resp = ui.interact(rect, id, egui::Sense::click());

    let hot = on && resp.hovered();
    let down = on && resp.is_pointer_button_down_on();
    let bg = if down {
        sk.route_dim
    } else if hot {
        sk.row_hover
    } else {
        sk.header_bg
    };
    let fg = if !on {
        sk.faint
    } else if hot || down {
        sk.title
    } else {
        sk.dim
    };

    let p = ui.painter();
    let rounding = egui::Rounding::same(3.0 * k);
    p.rect_filled(rect, rounding, bg);
    p.rect_stroke(rect, rounding, egui::Stroke::new(1.0, sk.rule));
    p.text(
        rect.center(),
        egui::Align2::CENTER_CENTER,
        label,
        egui::FontId::proportional(9.5 * k),
        fg,
    );

    resp.clicked() && on
}

/// Exactly the height `TextEdit` will occupy for `text` at this width.
///
/// Computed rather than assumed, using the same three numbers the widget does:
/// its row height for the font, the taller of the wrapped galley and the
/// minimum row count, and its own margin. A reserved height that disagrees with
/// what the widget draws is how the reply box came to overlap the row beneath
/// it -- egui grows the box to fit the text whether or not the row was measured
/// for it.
///
///   grep -n "let desired_height"  src/warp_core/egui/src/widgets/text_edit/builder/show.rs
fn field_h_for(ui: &egui::Ui, text: &str, width: f32) -> f32 {
    let k = sc();
    let font = egui::FontId::proportional(10.5 * k);
    let margin = egui::vec2(4.0 * k, 3.0 * k);
    let row_h = ui.fonts(|f| f.row_height(&font));
    let galley = ui.painter().layout(
        text.to_string(),
        font,
        egui::Color32::WHITE,
        (width - margin.x * 2.0).max(10.0),
    );
    galley.size().y.max(row_h * 2.0) + margin.y * 2.0
}

/// One row of the board. Returns whether it was clicked, which folds its file
/// list.
///
///   grep -n "fn draw_board_row"  sauron_panel.rs
fn draw_board_row(
    ui: &mut egui::Ui,
    r: &Row,
    colour: egui::Color32,
    expanded: bool,
    _stripe: bool,
) -> bool {
    let sk = skin();
    let k = sc();
    let waiting = wants_human(&r.status);
    let inner = panel_w() - pad() * 2.0;

    // ── measure first, allocate second ──────────────────────────────────
    // A row measured after it is allocated is the classic source of a
    // half-clipped last line, and of content overrunning into the footer.
    let stamp = if r.turn_started > 0 { r.turn_started } else { r.last_activity };
    let mut bits: Vec<String> = vec![status_label(&r.status).to_string()];
    if stamp > 0 {
        bits.push(elapsed(now_ms().saturating_sub(stamp)));
    }
    bits.push(format!("{} file{}", r.files.len(), plural(r.files.len())));
    if let Some(first) = r.steps.first() {
        bits.push(first.title.clone());
        if r.steps.len() > 1 {
            bits.push(format!("+{}", r.steps.len() - 1));
        }
    }
    let meta = ui.painter().layout(
        bits.join("  ·  "),
        egui::FontId::proportional(9.5 * k),
        sk.faint,
        inner - 14.0 * k,
    );
    let title = ui.painter().layout(
        display_name(r),
        egui::FontId::proportional(12.0 * k),
        sk.title,
        inner,
    );
    let files: Vec<_> = if expanded {
        r.files
            .iter()
            .map(|f| {
                ui.painter().layout(
                    f.clone(),
                    egui::FontId::monospace(8.5 * k),
                    sk.file,
                    inner - 12.0 * k,
                )
            })
            .collect()
    } else {
        Vec::new()
    };

    // What has already been said to this agent. Cloned out under the lock and
    // the guard dropped immediately: `draw_reply_row` takes the same mutex, and
    // holding it across that call would deadlock on the first waiting row.
    let (sent, draft_text): (Vec<String>, String) = if waiting {
        drafts()
            .lock()
            .ok()
            .and_then(|m| m.get(&r.id).map(|d| (d.sent.clone(), d.text.clone())))
            .unwrap_or_default()
    } else {
        (Vec::new(), String::new())
    };
    let sent: Vec<_> = sent
        .iter()
        .map(|t| {
            ui.painter().layout(
                format!("› {t}"),
                egui::FontId::proportional(9.5 * k),
                sk.route_dim,
                inner - 8.0 * k,
            )
        })
        .collect();

    let meta_h = meta.size().y;
    let title_h = title.size().y;
    let files_h: f32 = files.iter().map(|g| g.size().y + 2.0 * k).sum();
    let sent_h: f32 = sent.iter().map(|g| g.size().y + 2.0 * k).sum();
    // Measured from the text the box currently holds, so a row grows as its
    // draft wraps instead of being overrun by it.
    let field_h = if waiting {
        field_h_for(ui, &draft_text, inner - action_w() * 3.0 - 12.0 * k)
    } else {
        0.0
    };

    let mut h = 7.0 * k + meta_h + 3.0 * k + title_h + 7.0 * k;
    if waiting {
        h += field_h + 5.0 * k;
    }
    if !sent.is_empty() {
        h += sent_h + 3.0 * k;
    }
    if !files.is_empty() {
        h += files_h + 4.0 * k;
    }

    let (rect, resp) = ui.allocate_exact_size(egui::vec2(panel_w(), h), egui::Sense::click());

    // Publish what this row points at, so a host can draw a line from it to the
    // control in question. Only anchors that name something: a surface with no
    // button has nothing to run a cable to, and a cable into empty screen is
    // worse than no cable.
    //
    // Done here, beside the row's own rect, because that rect IS the source of
    // the line -- and losing this one statement in a layout rewrite silently
    // turns the whole feature off, which is exactly what happened.
    if resp.hovered() {
        if let Ok(mut hv) = hover_state().lock() {
            *hv = Some((
                rect,
                r.steps
                    .iter()
                    .filter(|st| !st.anchor.is_empty())
                    .map(|st| st.anchor.clone())
                    .collect(),
            ));
        }
    }

    {
        let p = ui.painter();
        if resp.hovered() {
            p.rect_filled(rect, egui::Rounding::same(4.0 * k), sk.row_hover);
        }
        // Severity bar: what makes the board readable at a glance without
        // reading any of the words.
        p.rect_filled(
            egui::Rect::from_min_max(
                egui::pos2(rect.left() + 2.0 * k, rect.top() + 3.0 * k),
                egui::pos2(rect.left() + 4.5 * k, rect.bottom() - 3.0 * k),
            ),
            egui::Rounding::same(1.5 * k),
            colour,
        );

        let x = rect.left() + pad();
        let mut y = rect.top() + 7.0 * k;

        // status pip, then the whole metadata line
        p.circle_filled(egui::pos2(x + 3.0 * k, y + meta_h * 0.5), 3.0 * k, colour);
        p.galley(egui::pos2(x + 11.0 * k, y), meta);
        y += meta_h + 3.0 * k;

        p.galley(egui::pos2(x, y), title);
        y += title_h;

        if !files.is_empty() {
            y += 4.0 * k;
            for g in files {
                let gh = g.size().y;
                p.circle_filled(egui::pos2(x + 3.0 * k, y + gh * 0.5), 1.5 * k, sk.faint);
                p.galley(egui::pos2(x + 11.0 * k, y), g);
                y += gh + 2.0 * k;
            }
        }

        // Your side of the conversation, newest last, directly above the box
        // you would type the next one into.
        if !sent.is_empty() {
            y += 3.0 * k;
            for g in sent {
                let gh = g.size().y;
                p.galley(egui::pos2(x, y), g);
                y += gh + 2.0 * k;
            }
        }
    }

    if waiting {
        let top = rect.bottom() - pad() * 0.7 - field_h;
        draw_reply_row(
            ui,
            r,
            egui::Rect::from_min_size(
                egui::pos2(rect.left() + pad(), top),
                egui::vec2(inner, field_h),
            ),
        );
    }

    resp.clicked()
}

/// The reply field and its three actions, in one exactly-placed strip.
///
/// The field takes whatever the buttons do not, so it grows with the pane
/// instead of being a fixed stub. A sentence about something on screen is the
/// unit here -- "the flag clips through the hull on the port side" -- and a box
/// showing six characters of it invites the shortest possible message rather
/// than a useful one.
///
///   grep -n "fn draw_reply_row"  sauron_panel.rs
fn draw_reply_row(ui: &mut egui::Ui, r: &Row, strip: egui::Rect) {
    let sk = skin();
    let k = sc();
    let mut queued: Option<(&'static str, String, String)> = None;
    let mut shot = false;

    let Ok(mut all) = drafts().lock() else { return };
    let d = all.entry(r.id.clone()).or_default();

    let gap = 4.0 * k;
    let actions_w = action_w() * 3.0 + gap * 2.0;
    let field_w = (strip.width() - actions_w - gap).max(60.0 * k);

    let field_rect =
        egui::Rect::from_min_size(strip.min, egui::vec2(field_w, strip.height()));
    let f = egui::FontId::proportional(10.5 * k);

    let changed = ui
        .put(
            field_rect,
            egui::TextEdit::multiline(&mut d.text)
                .font(f.clone())
                .margin(egui::vec2(4.0 * k, 3.0 * k))
                .desired_rows(2)
                .desired_width(field_w)
                .hint_text(
                    egui::RichText::new("reply to this agent…")
                        .font(f)
                        .color(sk.faint),
                ),
        )
        .changed();
    if changed {
        d.status.clear();
    }

    // Buttons on their own baseline, vertically centred against the field.
    let by = strip.center().y - action_h() * 0.5;
    let bx = strip.right() - actions_w;
    let btn = |i: usize| {
        egui::Rect::from_min_size(
            egui::pos2(bx + (action_w() + gap) * i as f32, by),
            egui::vec2(action_w(), action_h()),
        )
    };

    if action_button(ui, (&r.id, "send"), btn(0), "send", !d.text.trim().is_empty()) {
        queued = Some(("reply", d.text.clone(), d.attach.clone()));
    }
    if action_button(ui, (&r.id, "shot"), btn(1), "shot", true) {
        shot = true;
    }
    if action_button(ui, (&r.id, "ack"), btn(2), "ack", true) {
        queued = Some(("ack", String::new(), String::new()));
    }

    // Status and attachment live under the strip, painted rather than laid out,
    // so they cannot push the row's geometry around after it was measured.
    if !d.status.is_empty() || !d.attach.is_empty() {
        let mut note = d.status.clone();
        if !d.attach.is_empty() {
            note = format!("{}  {}", short_path(&d.attach), note);
        }
        ui.painter().text(
            egui::pos2(strip.left(), strip.bottom() + 1.0 * k),
            egui::Align2::LEFT_TOP,
            note.trim(),
            egui::FontId::proportional(8.5 * k),
            sk.route_dim,
        );
    }

    if shot {
        match take_screenshot() {
            Ok(p) => {
                d.attach = p;
                d.status = "attached".into();
            }
            // Surfaced rather than swallowed: the usual cause is macOS refusing
            // Screen Recording to this binary, which is a permission to grant,
            // not a bug to puzzle over.
            Err(e) => d.status = format!("no shot: {e}"),
        }
    }
    if let Some((kind, text, attach)) = queued {
        match queue_message(kind, &r.id, &text, &attach) {
            Ok(()) => {
                if kind == "reply" {
                    d.sent.push(delivered_line(&text, &attach));
                    if d.sent.len() > SENT_KEPT {
                        d.sent.remove(0);
                    }
                }
                d.text.clear();
                d.attach.clear();
                d.status = if kind == "ack" { "acked".into() } else { "sent".into() };
            }
            Err(e) => d.status = format!("failed: {e}"),
        }
    }
}

/// The short status word shown at the head of the metadata line.
fn status_label(status: &str) -> &'static str {
    GROUPS
        .iter()
        .find(|(tok, _)| *tok == status)
        .map(|(_, title)| *title)
        .unwrap_or("—")
}

/// Just the file name -- the temp directory prefix is noise in a narrow pane.
fn short_path(p: &str) -> &str {
    p.rsplit('/').next().unwrap_or(p)
}

/// The always-visible strip: dot, title, count, caret./// The always-visible strip: dot, title, count, caret. It is both the fold
/// control and the drag handle, and returns this frame's drag delta.
///
/// One surface, two gestures, told apart by egui: with `click_and_drag`, a
/// press that moved does not report `clicked()`. That is what keeps the pane
/// from folding itself every time you finish dragging it. The rows below cannot
/// be confused for a handle at all, because the drag lives here rather than on
/// the area.
fn draw_header(ui: &mut egui::Ui, b: &Beacon) -> egui::Vec2 {
    let collapsed = COLLAPSED.load(Ordering::Relaxed);
    let (rect, resp) =
        ui.allocate_exact_size(egui::vec2(panel_w(), header_h()), egui::Sense::click_and_drag());
    let dragging = resp.dragged();
    if dragging {
        ui.ctx().set_cursor_icon(egui::CursorIcon::Grabbing);
    } else if resp.hovered() {
        ui.ctx().set_cursor_icon(egui::CursorIcon::Grab);
    }
    let p = ui.painter();

    let rounding = if collapsed {
        egui::Rounding::same(7.0)
    } else {
        egui::Rounding {
            nw: 7.0,
            ne: 7.0,
            sw: 0.0,
            se: 0.0,
        }
    };
    p.rect_filled(rect, rounding, Palette::HEADER_BG());

    // Severity dot: the colour of the worst thing on the board. On a folded
    // pane this is the entire signal, so it is drawn first and never elided.
    let worst = worst_colour(b);
    p.circle_filled(egui::pos2(rect.left() + pad() + 3.0, rect.center().y), 4.0, worst);

    // Measured, not guessed. A hardcoded offset for the summary put it on top
    // of the title the moment the host's font was wider than the number picked
    // here, which rendered as "SAURONneeds attention".
    let title = p.layout_no_wrap(
        "SAURON".to_string(),
        egui::FontId::proportional(12.0 * sc()),
        Palette::TITLE(),
    );
    let title_w = title.size().x;
    let title_x = rect.left() + pad() + 15.0;
    p.galley(
        egui::pos2(title_x, rect.center().y - title.size().y * 0.5),
        title,
    );

    let summary = if b.attention == 0 {
        "nothing outstanding".to_string()
    } else if b.attention == 1 {
        "1 needs attention".to_string()
    } else {
        format!("{} need attention", b.attention)
    };
    p.text(
        egui::pos2(title_x + title_w + 10.0, rect.center().y),
        egui::Align2::LEFT_CENTER,
        summary,
        egui::FontId::proportional(11.0 * sc()),
        if b.attention == 0 {
            Palette::FAINT()
        } else {
            Palette::DIM()
        },
    );

    // Caret. Drawn rather than typed so it points the right way in any font.
    let cx = rect.right() - pad() - 4.0;
    let cy = rect.center().y;
    let tint = if resp.hovered() {
        Palette::TITLE()
    } else {
        Palette::DIM()
    };
    let tri = if collapsed {
        [
            egui::pos2(cx - 5.0, cy - 3.0),
            egui::pos2(cx + 1.0, cy),
            egui::pos2(cx - 5.0, cy + 3.0),
        ]
    } else {
        [
            egui::pos2(cx - 6.0, cy - 2.0),
            egui::pos2(cx, cy + 3.0),
            egui::pos2(cx + 6.0, cy - 2.0),
        ]
    };
    p.add(egui::Shape::convex_polygon(tri.to_vec(), tint, egui::Stroke::NONE));

    if !collapsed {
        p.line_segment(
            [
                egui::pos2(rect.left(), rect.bottom() - 0.5),
                egui::pos2(rect.right(), rect.bottom() - 0.5),
            ],
            egui::Stroke::new(1.0, Palette::RULE()),
        );
    }

    if resp.clicked() {
        COLLAPSED.fetch_xor(true, Ordering::Relaxed);
    }

    let delta = resp.drag_delta();
    // No tooltip mid-drag: it would follow the cursor across the screen while
    // the thing it describes is being moved out from under it.
    if !dragging {
        resp.on_hover_text(format!(
            "sauron pid {} watching {}\nclick to {} · drag to move",
            b.pid,
            b.label,
            if collapsed { "expand" } else { "collapse" }
        ));
    }
    delta
}

/// The worst status present, as a colour. Drives the folded pane's one dot.
fn worst_colour(b: &Beacon) -> egui::Color32 {
    let mut best: Option<(usize, egui::Color32)> = None;
    for r in &b.rows {
        if let Some((_, colour, rank)) = group_of(&r.status) {
            if best.map_or(true, |(cur, _)| rank < cur) {
                best = Some((rank, colour));
            }
        }
    }
    best.map(|(_, c)| c).unwrap_or(Palette::FAINT())
}


/// What the card calls this session. Orcs get a marker: they are sauron's own
/// single-shot maintenance agents, and mistaking one for a task you started is
/// how a clean file ends up looking like unexplained churn.
fn display_name(r: &Row) -> String {
    let edits = if r.total_edits > 0 {
        format!("  ·  {} edit{}", r.total_edits, plural(r.total_edits))
    } else {
        String::new()
    };
    if r.is_orc {
        format!("orc  {}{}", r.name, edits)
    } else {
        format!("{}{}", r.name, edits)
    }
}

fn plural(n: usize) -> &'static str {
    if n == 1 {
        ""
    } else {
        "s"
    }
}

fn draw_all_clear(ui: &mut egui::Ui) {
    let (rect, _) = ui.allocate_exact_size(egui::vec2(panel_w(), 34.0), egui::Sense::hover());
    ui.painter().text(
        egui::pos2(rect.left() + pad(), rect.center().y),
        egui::Align2::LEFT_CENTER,
        "board clear — nothing waiting on you",
        egui::FontId::proportional(11.0 * sc()),
        Palette::FAINT(),
    );
}

fn draw_footer(ui: &mut egui::Ui, b: &Beacon) {
    let mut bits: Vec<String> = Vec::new();
    if b.clear > 0 {
        bits.push(format!("{} clear", b.clear));
    }
    if b.hidden_stale > 0 {
        bits.push(format!("{} stale", b.hidden_stale));
    }
    bits.push(b.label.clone());
    let line = bits.join("  ·  ");

    let (rect, _) = ui.allocate_exact_size(egui::vec2(panel_w(), 20.0), egui::Sense::hover());
    let p = ui.painter();
    p.line_segment(
        [
            egui::pos2(rect.left() + pad(), rect.top() + 0.5),
            egui::pos2(rect.right() - pad(), rect.top() + 0.5),
        ],
        egui::Stroke::new(1.0, Palette::RULE()),
    );
    p.text(
        egui::pos2(rect.left() + pad(), rect.center().y + 1.0),
        egui::Align2::LEFT_CENTER,
        line,
        egui::FontId::proportional(9.5 * sc()),
        Palette::FAINT(),
    );
}

/// `12s`, `4m12s`, `1h04m`. Compact enough to right-align on a card without
/// pushing the name; coarse enough that it is not a stopwatch.
fn elapsed(ms: i64) -> String {
    let s = (ms / 1000).max(0);
    if s < 60 {
        return format!("{s}s");
    }
    let m = s / 60;
    if m < 60 {
        return format!("{m}m{:02}s", s % 60);
    }
    format!("{}h{:02}m", m / 60, m % 60)
}
